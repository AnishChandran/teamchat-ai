APP_NAME=teamchat-ai
DEBUG=true
FIREBASE_PROJECT_ID=your-firebase-project-id

# Local development only. Do NOT set on Cloud Run — use the runtime service account (ADC).
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

VERTEX_AI_PROJECT_ID=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_DELAY_SECONDS=0.5

# Cloud Run sets PORT automatically. Local uvicorn defaults to 8000 unless overridden.
# PORT=8080
