# Production build for Firebase Hosting.
# REST uses Hosting rewrite (/api); WebSockets must use Cloud Run directly.
#
# Copy to .env.production before: npm run build

VITE_API_URL=
# Required in production — Firebase Hosting does not proxy WebSocket upgrades.
# gcloud run services describe teamchat-ai-backend --region us-central1 --format='value(status.url)'
VITE_WS_URL=wss://teamchat-ai-backend-PROJECT_NUMBER.us-central1.run.app

# Firebase web app config (Firebase Console → Project settings → Your apps)
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Option B — direct Cloud Run (requires backend CORS; not configured by default):
# VITE_API_URL=https://teamchat-ai-backend-xxxxx-uc.a.run.app
# VITE_WS_URL=wss://teamchat-ai-backend-xxxxx-uc.a.run.app
